<Window x:Class="UsbForensicAudit.DeviceActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История действий на устройстве"
        Width="1180"
        Height="760"
        MinWidth="800"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#07111F">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E5F2FF"/>
            <Setter Property="Background" Value="#14532D"/>
            <Setter Property="BorderBrush" Value="#38D996"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#081320"/>
            <Setter Property="Foreground" Value="#D8E9FA"/>
            <Setter Property="BorderBrush" Value="#1F3B59"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#12293F"/>
            <Setter Property="RowBackground" Value="#0B1728"/>
            <Setter Property="AlternatingRowBackground" Value="#0E1D30"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#12293F"/>
            <Setter Property="Foreground" Value="#9FC6E4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#1F3B59"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8E9FA"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#175A78"/>
                    <Setter Property="Foreground" Value="#E5F2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14" Padding="16" Background="#0B1728" BorderBrush="#1F3B59" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="#38BDF8"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="VerdictText"
                           Foreground="#D8E9FA"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <TextBlock Foreground="#8EA7BF" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Windows не записывает, что именно происходило с файлом. Она сохраняет следы обращений: какие папки открывали в проводнике, какие файлы открывали, что удаляли в корзину, что запускали. Столбец «Почему отнесено к этому устройству» показывает основание привязки — по нему вывод можно проверить."/>
                <TextBlock x:Name="WarningText"
                           Foreground="#FBBF24"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                <TextBlock Text="Показывать:" Foreground="#8EA7BF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="KindFilterCombo" Width="290" SelectionChanged="KindFilterCombo_SelectionChanged"/>
                <TextBlock x:Name="CountText" Foreground="#8EA7BF" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="Что делали">
                    <DataGrid x:Name="ActivityGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Когда" Binding="{Binding TimestampText}" Width="160"/>
                            <DataGridTextColumn Header="Что делали" Binding="{Binding KindText}" Width="240"/>
                            <DataGridTextColumn Header="Папка или файл" Binding="{Binding PathText}" Width="360"/>
                            <DataGridTextColumn Header="Кто" Binding="{Binding UserText}" Width="170"/>
                            <DataGridTextColumn Header="Почему отнесено к этому устройству" Binding="{Binding LinkText}" Width="290"/>
                            <DataGridTextColumn Header="Что означает время" Binding="{Binding TimeMeaning}" Width="330"/>
                            <DataGridTextColumn Header="Откуда взято" Binding="{Binding SourceText}" Width="230"/>
                            <DataGridTextColumn Header="Ссылка на источник" Binding="{Binding Provenance}" Width="360"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Признаки копирования">
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock x:Name="CopyVerdictText"
                                   DockPanel.Dock="Top"
                                   Foreground="#FBBF24"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <DataGrid x:Name="CopyGrid" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя файла" Binding="{Binding FileName}" Width="240"/>
                                <DataGridTextColumn Header="Путь на устройстве" Binding="{Binding PathOnDevice}" Width="330"/>
                                <DataGridTextColumn Header="Когда виден на устройстве" Binding="{Binding SeenOnDeviceText}" Width="180"/>
                                <DataGridTextColumn Header="Путь на внутреннем диске" Binding="{Binding LocalPath}" Width="330"/>
                                <DataGridTextColumn Header="Когда виден на диске" Binding="{Binding SeenLocallyText}" Width="180"/>
                                <DataGridTextColumn Header="Откуда взято" Binding="{Binding Source}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="По каким признакам искали">
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LinkKeysText" Foreground="#D8E9FA" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Скопировать историю в буфер"
                        Background="#123B57"
                        BorderBrush="#38BDF8"
                        Margin="0,0,10,0"
                        Click="CopyButton_Click"/>
                <Button Content="Закрыть" IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
