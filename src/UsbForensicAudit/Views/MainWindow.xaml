<Window x:Class="UsbForensicAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UsbForensicAudit"
        mc:Ignorable="d"
        Title="Аудит USB — форензика"
        Height="820"
        Width="1320"
        MinHeight="720"
        MinWidth="1120"
        FontFamily="Segoe UI"
        Background="#0A0E1A">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0A0E1A"/>
        <SolidColorBrush x:Key="Panel" Color="#111726"/>
        <SolidColorBrush x:Key="Panel2" Color="#16203A"/>
        <SolidColorBrush x:Key="Stroke" Color="#1E2A44"/>
        <SolidColorBrush x:Key="TextMain" Color="#E6EDF7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B98B8"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="Accent2" Color="#6FA8FF"/>
        <SolidColorBrush x:Key="Warn" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
        <SolidColorBrush x:Key="Ok" Color="#22C55E"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#0D1322"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#7FB4FF"/>
        <SolidColorBrush x:Key="TextSoft" Color="#D7E0F0"/>
        <local:CellExplanationToolTipConverter x:Key="CellExplanationToolTipConverter"/>
        <local:DeviceExternalityBrushConverter x:Key="DeviceExternalityBrushConverter"/>
        <local:NetworkConnectionBrushConverter x:Key="NetworkConnectionBrushConverter"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6EDF7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MaxWidth" Value="540"/>
            <Setter Property="Placement" Value="Top"/>
            <Setter Property="VerticalOffset" Value="-8"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#182238"
                                BorderBrush="{StaticResource Accent2}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource TextMain}"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6EDF7"/>
            <Setter Property="Background" Value="#141C30"/>
            <Setter Property="BorderBrush" Value="#263354"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B2742"/>
                                <Setter Property="BorderBrush" Value="#6FA8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8B98B8"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#132A44"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6FA8FF"/>
                                <Setter Property="Foreground" Value="#E6EDF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1322"/>
            <Setter Property="Foreground" Value="#D7E0F0"/>
            <Setter Property="BorderBrush" Value="#1E2A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1A2F49"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1A2F49"/>
            <Setter Property="RowBackground" Value="#111726"/>
            <Setter Property="AlternatingRowBackground" Value="#0E1D30"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#122840"/>
            <Setter Property="Foreground" Value="#BFE7FF"/>
            <Setter Property="BorderBrush" Value="#1E2A44"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#D7E0F0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#175A78"/>
                    <Setter Property="Foreground" Value="#E6EDF7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExplainedDataGridCellStyle"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
            <Setter Property="ToolTipService.Placement" Value="Top"/>
            <Setter Property="ToolTipService.VerticalOffset" Value="-8"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource CellExplanationToolTipConverter}">
                        <Binding/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111726"/>
            <Setter Property="BorderBrush" Value="#1E2A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#12304A" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#08111F" Offset="0"/>
                    <GradientStop Color="#0D2136" Offset="0.55"/>
                    <GradientStop Color="#0A0E1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="88"
                            Height="88"
                            Margin="0,0,18,0"
                            CornerRadius="18"
                            Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Accent2}"
                            BorderThickness="1.5"
                            Padding="6">
                        <Image x:Name="HeaderLogoImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,0,0,2">
                            <Run Text="Аудит " Foreground="{StaticResource TextMain}"/>
                            <Run Text="USB" Foreground="{StaticResource Accent2}" FontWeight="Bold" FontSize="32"/>
                            <Run Text="  ·  " Foreground="#3D5A73" FontSize="22"/>
                            <Run Text="форензика" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Medium"/>
                        </TextBlock>
                        <TextBlock Text="Мониторинг подключений, история устройств и поиск следов очистки"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ElevateButton" Content="Запуск от администратора" Click="ElevateButton_Click"/>
                    <Button x:Name="ScanButton" Content="Полное сканирование" Click="ScanButton_Click" Background="#2456B4" BorderBrush="#4C8DFF"/>
                    <Button x:Name="MonitorButton" Content="Старт мониторинга" Click="MonitorButton_Click"/>
                    <Button x:Name="ShowActiveDevicesButton" Content="Окно USB" IsEnabled="False" Click="ShowActiveDevicesButton_Click"/>
                    <Button x:Name="StopMonitorButton" Content="Стоп" IsEnabled="False" Click="StopMonitorButton_Click" Background="#33121C" BorderBrush="{StaticResource Danger}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Обзор">
                <Grid Margin="4,14,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,14">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AnswerDevicesBar" Background="{StaticResource Accent2}" CornerRadius="12,0,0,12"/>
                                <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                    <TextBlock Text="ПОДКЛЮЧАЛИ ЛИ ВНЕШНИЕ НОСИТЕЛИ?" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="AnswerDevicesVerdict" Text="Выполните сканирование" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="AnswerDevicesNote" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AnswerExfilBar" Background="{StaticResource Stroke}" CornerRadius="12,0,0,12"/>
                                <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                    <TextBlock Text="УХОДИЛИ ЛИ ДАННЫЕ?" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="AnswerExfilVerdict" Text="Выполните сканирование" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="AnswerExfilNote" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AnswerCleanupBar" Background="{StaticResource Stroke}" CornerRadius="12,0,0,12"/>
                                <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                    <TextBlock Text="ЧИСТИЛИ ЛИ СЛЕДЫ?" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="AnswerCleanupVerdict" Text="Выполните сканирование" Foreground="{StaticResource TextMain}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="AnswerCleanupNote" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Установка Windows: " Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="OsInstallDateText" Text="не определена" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="OsInstallGraceText"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Устройства" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="DevicesCountText" Text="0" Foreground="{StaticResource Accent}" FontSize="32" FontWeight="SemiBold"/>
                                <TextBlock Text="Все USB/Type-C, которые Windows когда-либо видела" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Доказательства" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="EvidenceCountText" Text="0" Foreground="{StaticResource Accent2}" FontSize="32" FontWeight="SemiBold"/>
                                <TextBlock Text="События и записи, по которым строится история" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Признаки очистки" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="FindingsCountText" Text="0" Foreground="{StaticResource Warn}" FontSize="32" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FindingsSubText" Text="Подозрительных записей; все находки — на вкладке «Следы очистки»" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Статус" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="AdminStatusText" Text="Проверка..." Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="3" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="12">
                        <TextBox x:Name="ActivityLogTextBox"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#BFE7FF"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="USB устройства">
                <DockPanel Margin="4,14,4,4">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Здесь список USB и Type-C устройств, которые Windows когда-либо видела на этом компьютере."
                                       Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Одно устройство Windows описывает несколькими записями: у телефона по Bluetooth это полтора десятка услуг, у веб-камеры — видеопоток и микрофон, у флешки — запись шины, накопителя и переносимого устройства. В списке стоит одно устройство одной строкой, остальные записи свёрнуты в него и видны по двойному щелчку. Ничего не потеряно — галочка ниже возвращает все записи."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ExternalDeviceSummary}"
                                       Foreground="{StaticResource AccentSoft}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Цвет строки отвечает на вопрос «устройство принесли с собой или оно всегда было внутри машины»."
                                       Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Зелёный" Foreground="{StaticResource AccentSoft}" FontWeight="SemiBold"/>
                                <Run Text="— внешний носитель или телефон: именно этим выносят данные."/>
                                <LineBreak/>
                                <Run Text="Синий" Foreground="#7DD3FC" FontWeight="SemiBold"/>
                                <Run Text="— другое внешнее устройство: пара по Bluetooth, карта памяти, устройство по Type-C или USB4, принесённый разветвитель."/>
                                <LineBreak/>
                                <Run Text="Жёлтый" Foreground="#FACC15"/>
                                <Run Text="— на шине USB, но отличить внешнее от распаянного внутри по следам нельзя."/>
                                <LineBreak/>
                                <Run Text="Приглушённый серо-синий" Foreground="#8FA3B7"/>
                                <Run Text="— встроенное в машину, а также части устройств и самой шины: корневые концентраторы, контроллеры, интерфейсы составных устройств, услуги сопряжённых устройств Bluetooth."/>
                                <LineBreak/>
                                <Run Text="Фиолетовый" Foreground="#C8C0F0"/>
                                <Run Text="— виртуальное устройство, созданное программой."/>
                                <Run Text="Сливовый" Foreground="#DCC4E6"/>
                                <Run Text="— след в реестре, самого устройства нет."/>
                                <Run Text="Коричневый" Foreground="#F5DCC8"/>
                                <Run Text="— запись, которую разобрать не удалось."/>
                            </TextBlock>
                            <TextBlock Text="«Когда отключали»: точная дата из журнала Windows, либо оценка по последней активности, либо «Подключено сейчас». VID и PID — технические коды, не названия производителя."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="usbflags — кэш USB-дескрипторов Windows. Такие строки подтверждают сохранённый VID/PID; производитель и модель уточняются по USBVendors, но этот след сам по себе не доказывает текущее подключение."
                                       Foreground="#B8A9FF"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Наведите указатель на любую ячейку — над ней появится простое объяснение значения."
                                       Foreground="{StaticResource Accent2}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Фильтр transport/classification:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="DeviceFilterCombo" Width="250" SelectionChanged="DeviceFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="Все устройства" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Только внешние устройства" Tag="ExternalOnly"/>
                                    <ComboBoxItem Content="Только носители и телефоны" Tag="ExternalMedia"/>
                                    <ComboBoxItem Content="Внешние" Tag="External"/>
                                    <ComboBoxItem Content="Встроенные" Tag="BuiltIn"/>
                                    <ComboBoxItem Content="Hub / infrastructure" Tag="Hub"/>
                                    <ComboBoxItem Content="Composite interfaces" Tag="Composite"/>
                                    <ComboBoxItem Content="Virtual" Tag="Virtual"/>
                                    <ComboBoxItem Content="Не определено" Tag="Unknown"/>
                                    <ComboBoxItem Content="UASP / SCSI" Tag="UASP/SCSI"/>
                                    <ComboBoxItem Content="MTP / PTP / WPD" Tag="MTP/PTP/WPD"/>
                                    <ComboBoxItem Content="USB4 / Thunderbolt" Tag="USB4/Thunderbolt"/>
                                </ComboBox>
                                <CheckBox x:Name="AllRecordsCheck"
                                          Content="Показывать все записи реестра"
                                          Foreground="{StaticResource TextMuted}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0"
                                          ToolTip="Вернёт в список услуги сопряжённых устройств, грани составных устройств и части шины: концентраторы, контроллеры, служебные узлы."
                                          Checked="AllRecordsCheck_Changed"
                                          Unchecked="AllRecordsCheck_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="DevicesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CellStyle="{StaticResource ExplainedDataGridCellStyle}"
                              ItemsSource="{Binding Devices}"
                              MouseDoubleClick="DevicesGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="{Binding Externality, Converter={StaticResource DeviceExternalityBrushConverter}, ConverterParameter=Background}"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Externality, Converter={StaticResource DeviceExternalityBrushConverter}, ConverterParameter=Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExternalDevice}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#175A78"/>
                                        <Setter Property="Foreground" Value="#E6EDF7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Внешнее устройство?" Binding="{Binding ExternalityText}" Width="200"/>
                            <DataGridTextColumn x:Name="PolicyColumn" Visibility="Collapsed" Header="Политика" Binding="{Binding PolicyBadgeText}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PolicyDecision}" Value="Blocked">
                                                <Setter Property="Foreground" Value="#F87171"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PolicyDecision}" Value="Unlisted">
                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PolicyDecision}" Value="Approved">
                                                <Setter Property="Foreground" Value="#7EE787"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Что это за запись" Binding="{Binding UserMeaning}" Width="250"/>
                            <DataGridTextColumn Header="Имя устройства" Binding="{Binding DisplayName}" Width="220"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding CategoryText}" Width="170"/>
                            <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="170"/>
                            <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="170"/>
                            <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="130"/>
                            <DataGridTextColumn Header="Confidence / evidence" Binding="{Binding ClassificationEvidenceText}" Width="300"/>
                            <DataGridTextColumn Header="Когда подключали" Binding="{Binding FirstConnectedText}" Width="170"/>
                            <DataGridTextColumn Header="Когда отключали" Binding="{Binding LastDisconnectedText}" Width="220"/>
                            <DataGridTextColumn Header="Последняя активность" Binding="{Binding LastSeenText}" Width="170"/>
                            <DataGridTextColumn Header="Пояснение по датам" Binding="{Binding DateConfidenceText}" Width="320"/>
                            <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerText}" Width="140"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding ModelText}" Width="160"/>
                            <DataGridTextColumn Header="VID / PID" Binding="{Binding VidPidText}" Width="120"/>
                            <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialText}" Width="160"/>
                            <DataGridTextColumn Header="Расположение в USB" Binding="{Binding LocationDisplayText}" Width="180"/>
                            <DataGridTextColumn Header="Откуда взята информация" Binding="{Binding SourceText}" Width="220"/>
                            <DataGridTextColumn Header="Системный ID" Binding="{Binding DeviceInstanceId}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Сетевые подключения">
                <TabControl Margin="4,14,4,4">
                    <TabItem Header="История связей">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Здесь связи этой машины с внешним миром: сети Wi-Fi и провод, туннели VPN, мобильный интернет, пары по Bluetooth, серверы с сетевыми папками, узлы удалённого рабочего стола и сайты."
                                       Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding NetworkSummary}"
                                       Foreground="{StaticResource AccentSoft}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Двойной щелчок по строке открывает окно со всей её историей: когда соединялись и сколько держалось соединение, какие папки и адреса открывали, что скачивали."
                                       Foreground="{StaticResource Accent2}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Цвет строки отвечает на вопрос «каким способом связывались»."
                                       Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Зелёный" Foreground="{StaticResource AccentSoft}" FontWeight="SemiBold"/>
                                <Run Text="— сервер с сетевыми папками: через них файлы уходят с машины и приходят на неё."/>
                                <LineBreak/>
                                <Run Text="Оранжевый" Foreground="#FFB870" FontWeight="SemiBold"/>
                                <Run Text="— удалённый рабочий стол: чужой машиной управляли отсюда или этой машиной управляли извне."/>
                                <LineBreak/>
                                <Run Text="Фиолетовый" Foreground="#C8C0F0"/>
                                <Run Text="— туннель VPN: он уводит связь в чужую сеть в обход своей."/>
                                <LineBreak/>
                                <Run Text="Синий" Foreground="#DFF3FF"/>
                                <Run Text="— сеть Wi-Fi."/>
                                <Run Text="Тёмно-синий" Foreground="#D6DEFF"/>
                                <Run Text="— пара по Bluetooth."/>
                                <Run Text="Бирюзовый" Foreground="#CFF4FA"/>
                                <Run Text="— мобильный интернет."/>
                                <LineBreak/>
                                <Run Text="Приглушённый серо-синий" Foreground="#9FB4C8"/>
                                <Run Text="— проводная сеть."/>
                                <Run Text="Сливовый" Foreground="#DCC4E6"/>
                                <Run Text="— посещённый сайт: их сотни, поэтому они стоят в конце списка."/>
                            </TextBlock>
                            <TextBlock Text="Пустых клеток здесь нет: если Windows чего-то не сохранила, в клетке об этом сказано словами. «Сеансов» — сколько раз соединялись по записям журналов, «обращений» — сколько папок, адресов и файлов найдено внутри этой связи."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Показывать:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="NetworkFilterCombo" Width="320" SelectionChanged="NetworkFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="Все связи" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Только то, чем данные могли уйти" Tag="OutsideReach"/>
                                    <ComboBoxItem Content="Сетевые папки" Tag="NetworkShare"/>
                                    <ComboBoxItem Content="Удалённый рабочий стол" Tag="RemoteDesktop"/>
                                    <ComboBoxItem Content="Сети Wi-Fi" Tag="WiFi"/>
                                    <ComboBoxItem Content="Проводные сети" Tag="Wired"/>
                                    <ComboBoxItem Content="Туннели VPN" Tag="Vpn"/>
                                    <ComboBoxItem Content="Мобильный интернет" Tag="MobileBroadband"/>
                                    <ComboBoxItem Content="Bluetooth" Tag="Bluetooth"/>
                                    <ComboBoxItem Content="Сайты" Tag="WebSite"/>
                                </ComboBox>
                                <TextBlock x:Name="NetworkCountText"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="NetworkGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CellStyle="{StaticResource ExplainedDataGridCellStyle}"
                              MouseDoubleClick="NetworkGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="{Binding Kind, Converter={StaticResource NetworkConnectionBrushConverter}, ConverterParameter=Background}"/>
                                <Setter Property="Foreground"
                                        Value="{Binding Kind, Converter={StaticResource NetworkConnectionBrushConverter}, ConverterParameter=Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutsideReach}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#175A78"/>
                                        <Setter Property="Foreground" Value="#E6EDF7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Как связывались" Binding="{Binding KindText}" Width="180"/>
                            <DataGridTextColumn Header="С чем именно" Binding="{Binding TargetText}" Width="280"/>
                            <DataGridTextColumn Header="Кто начал" Binding="{Binding DirectionText}" Width="160"/>
                            <DataGridTextColumn Header="Что нашлось внутри" Binding="{Binding ActivityText}" Width="180"/>
                            <DataGridTextColumn Header="Первое подключение" Binding="{Binding FirstSeenText}" Width="180"/>
                            <DataGridTextColumn Header="Последнее подключение" Binding="{Binding LastSeenText}" Width="180"/>
                            <DataGridTextColumn Header="Чем защищено" Binding="{Binding SecurityText}" Width="240"/>
                            <DataGridTextColumn Header="Через что шла связь" Binding="{Binding AdapterText}" Width="240"/>
                            <DataGridTextColumn Header="Адреса этой машины" Binding="{Binding LocalAddressesText}" Width="300"/>
                            <DataGridTextColumn Header="Учётная запись" Binding="{Binding AccountText}" Width="180"/>
                            <DataGridTextColumn Header="Простыми словами" Binding="{Binding DetailsText}" Width="420"/>
                            <DataGridTextColumn Header="Откуда взято" Binding="{Binding SourcesText}" Width="280"/>
                            <DataGridTextColumn Header="Ссылка на источник" Binding="{Binding Provenance}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                    </TabItem>

                    <TabItem Header="Обстановка сейчас">
                        <DockPanel Margin="0,8,0,0">
                            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Снимок того, что видно прямо сейчас: сети Wi-Fi в эфире и устройства в текущей сети. Это не история — список меняется каждую минуту."
                                               Foreground="{StaticResource TextMain}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Windows не хранит список всех клиентов Wi-Fi. Здесь видны только те устройства, с которыми машина уже обменивалась данными, или те, кто ответил на опрос сети."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding NetworkEnvironmentSummary}"
                                               Foreground="{StaticResource AccentSoft}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="CaptureEnvironmentButton"
                                                Content="Снять обстановку"
                                                Padding="16,8"
                                                Click="CaptureEnvironmentButton_Click"/>
                                        <CheckBox x:Name="ActiveProbeCheck"
                                                  Content="Опросить сеть активно (медленнее, но найдёт больше)"
                                                  Foreground="{StaticResource TextMuted}"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0"/>
                                        <TextBlock x:Name="EnvironmentStatusText"
                                                   Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TabControl>
                                <TabItem Header="Wi-Fi в эфире">
                                    <DataGrid ItemsSource="{Binding WirelessNetworks}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CellStyle="{StaticResource ExplainedDataGridCellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Имя сети" Binding="{Binding SsidText}" Width="200"/>
                                            <DataGridTextColumn Header="Связь с машиной" Binding="{Binding RelationText}" Width="280"/>
                                            <DataGridTextColumn Header="Сигнал" Binding="{Binding SignalText}" Width="80"/>
                                            <DataGridTextColumn Header="Канал" Binding="{Binding ChannelText}" Width="120"/>
                                            <DataGridTextColumn Header="Защита" Binding="{Binding SecurityText}" Width="280"/>
                                            <DataGridTextColumn Header="Точка доступа" Binding="{Binding BssidText}" Width="180"/>
                                            <DataGridTextColumn Header="Производитель AP" Binding="{Binding VendorText}" Width="160"/>
                                            <DataGridTextColumn Header="Адаптер" Binding="{Binding Adapter}" Width="220"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Устройства в сети">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Top"
                                                  Content="Только устройства (спрятать эту машину, шлюз, DHCP и DNS)"
                                                  IsChecked="{Binding ShowOnlyDeviceNeighbors}"
                                                  Foreground="{StaticResource TextMuted}"
                                                  Margin="0,8,0,8"/>
                                        <DataGrid ItemsSource="{Binding NetworkNeighbors}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CellStyle="{StaticResource ExplainedDataGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Роль" Binding="{Binding RoleText}" Width="220"/>
                                                <DataGridTextColumn Header="IP-адрес" Binding="{Binding AddressText}" Width="140"/>
                                                <DataGridTextColumn Header="MAC" Binding="{Binding MacText}" Width="160"/>
                                                <DataGridTextColumn Header="Имя" Binding="{Binding NameText}" Width="220"/>
                                                <DataGridTextColumn Header="Откуда имя" Binding="{Binding NameSourceText}" Width="150"/>
                                                <DataGridTextColumn Header="Производитель" Binding="{Binding VendorText}" Width="160"/>
                                                <DataGridTextColumn Header="Как найдено" Binding="{Binding DiscoveryText}" Width="280"/>
                                                <DataGridTextColumn Header="Состояние" Binding="{Binding StateText}" Width="180"/>
                                                <DataGridTextColumn Header="Сеть" Binding="{Binding NetworkText}" Width="180"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Адаптеры">
                                    <DataGrid ItemsSource="{Binding NetworkAdapters}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Адаптер" Binding="{Binding NameText}" Width="260"/>
                                            <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="120"/>
                                            <DataGridTextColumn Header="Wi-Fi сеть" Binding="{Binding ConnectedSsid}" Width="180"/>
                                            <DataGridTextColumn Header="IP" Binding="{Binding AddressesText}" Width="140"/>
                                            <DataGridTextColumn Header="Подсеть" Binding="{Binding SubnetText}" Width="140"/>
                                            <DataGridTextColumn Header="Шлюз" Binding="{Binding GatewayText}" Width="140"/>
                                            <DataGridTextColumn Header="DHCP" Binding="{Binding DhcpServer}" Width="140"/>
                                            <DataGridTextColumn Header="DNS" Binding="{Binding DnsText}" Width="200"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="История устройств (за сессию)">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,8,0,8">
                                            <StackPanel>
                                                <TextBlock Text="История активности устройств в сети, накопленная из повторных снимков. Каждое нажатие «Снять обстановку» добавляет наблюдения сюда, а не стирает прошлые: так видно, кто появлялся в сети, когда впервые и когда в последний раз."
                                                           Foreground="{StaticResource TextMain}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="Устройства узнаются между снимками по заводскому аппаратному адресу. Случайный адрес (так с завода настроены телефоны) для опознания не годится: такое устройство в другой раз придёт под другим адресом, и его наблюдения намеренно не склеиваются — колонка «Опознание» говорит об этом прямо."
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding NetworkNeighborHistory}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CellStyle="{StaticResource ExplainedDataGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Роль" Binding="{Binding RoleText}" Width="200"/>
                                                <DataGridTextColumn Header="MAC" Binding="{Binding MacText}" Width="160"/>
                                                <DataGridTextColumn Header="Производитель" Binding="{Binding VendorText}" Width="160"/>
                                                <DataGridTextColumn Header="Имена" Binding="{Binding NamesText}" Width="220"/>
                                                <DataGridTextColumn Header="IP-адреса" Binding="{Binding IpAddressesText}" Width="180"/>
                                                <DataGridTextColumn Header="Сети" Binding="{Binding NetworksText}" Width="180"/>
                                                <DataGridTextColumn Header="Впервые замечено" Binding="{Binding FirstSeenText}" Width="180"/>
                                                <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeenText}" Width="180"/>
                                                <DataGridTextColumn Header="Замечено в" Binding="{Binding TimesSeenText}" Width="120"/>
                                                <DataGridTextColumn Header="Опознание" Binding="{Binding IdentityText}" Width="420"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Подключения к Wi-Fi (журнал Windows)">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,8,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Реальная история подключений самой машины к сетям Wi-Fi — из реестра и журналов Windows, а не из эфира. В отличие от снимка обстановки, это следы прошлого: к этим сетям машина действительно подключалась."
                                                           Foreground="{StaticResource TextMain}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="Список заполняется при полном сканировании. Подробности каждой сети — во вкладке «Сетевые связи»: двойной щелчок по строке там открывает все сеансы."
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding WiFiConnections}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CellStyle="{StaticResource ExplainedDataGridCellStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Имя сети" Binding="{Binding TargetText}" Width="260"/>
                                                <DataGridTextColumn Header="Первое подключение" Binding="{Binding FirstSeenText}" Width="180"/>
                                                <DataGridTextColumn Header="Последнее подключение" Binding="{Binding LastSeenText}" Width="180"/>
                                                <DataGridTextColumn Header="Что нашлось внутри" Binding="{Binding ActivityText}" Width="180"/>
                                                <DataGridTextColumn Header="Чем защищено" Binding="{Binding SecurityText}" Width="240"/>
                                                <DataGridTextColumn Header="Через что шла связь" Binding="{Binding AdapterText}" Width="240"/>
                                                <DataGridTextColumn Header="Простыми словами" Binding="{Binding DetailsText}" Width="420"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Доказательства">
                <DockPanel Margin="4,14,4,4">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"
                                       Text="Здесь все найденные следы: записи Windows, события подключения, ярлыки пользователя, запуск программ и признаки очистки. Это «сырые данные», по которым программа понимает историю USB."/>
                            <TextBlock Text="Наведите указатель на любую ячейку — над ней появится простое объяснение значения."
                                       Foreground="{StaticResource Accent2}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="EvidenceGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CellStyle="{StaticResource ExplainedDataGridCellStyle}"
                              ItemsSource="{Binding Evidence}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата и время" Binding="{Binding TimestampText}" Width="180"/>
                            <DataGridTextColumn Header="Что произошло" Binding="{Binding EvidenceCategoryText}" Width="Auto"/>
                            <DataGridTextColumn Header="Откуда взято" Binding="{Binding SourceText}" Width="Auto"/>
                            <DataGridTextColumn Header="Сила доказательства" Binding="{Binding EvidenceStrength}" Width="150"/>
                            <DataGridTextColumn Header="Уверенность" Binding="{Binding Confidence}" Width="120"/>
                            <DataGridTextColumn Header="ID события/записи" Binding="{Binding EventId}" Width="Auto"/>
                            <DataGridTextColumn Header="Связанное устройство" Binding="{Binding DeviceHintText}" Width="Auto"/>
                            <DataGridTextColumn Header="Простыми словами" Binding="{Binding UserExplanationText}" Width="Auto"/>
                            <DataGridTextColumn Header="Подробности" Binding="{Binding SummaryText}" Width="Auto"/>
                            <DataGridTextColumn Header="Provenance" Binding="{Binding Provenance}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Таймлайн">
                <DockPanel Margin="4,14,4,4">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Единая лента событий: подключения и активность USB, признаки очистки и сетевые связи — одной хронологией, новые сверху. Подозрительная очистка подсвечена."
                                       Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Тип:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="TimelineKindCombo" Width="200" SelectionChanged="TimelineFilter_Changed"/>
                                <TextBlock Text="Устройство:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <ComboBox x:Name="TimelineDeviceCombo" Width="280" SelectionChanged="TimelineFilter_Changed"/>
                                <TextBlock Text="Поиск:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                                <TextBox x:Name="TimelineSearchBox" Width="240" TextChanged="TimelineFilter_Changed" Background="{StaticResource PanelDeep}" Foreground="{StaticResource TextSoft}" CaretBrush="{StaticResource TextSoft}" BorderBrush="{StaticResource Stroke}" Padding="6,3"/>
                                <TextBlock x:Name="TimelineCountText" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="TimelineGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата и время" Binding="{Binding TimestampText}" Width="170"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="150"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="220"/>
                            <DataGridTextColumn Header="Устройство / объект" Binding="{Binding Device}" Width="260"/>
                            <DataGridTextColumn Header="Что произошло" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Следы очистки">
                <DockPanel Margin="4,14,4,4">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Здесь все найденные признаки очистки — и подозрительные, и нормальные после переустановки Windows (полный аудит)."
                                       Foreground="{StaticResource TextMain}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Колонки «Инициатор», «Инструмент» и «Уверенность» помогают отличить Windows, пользователя и утилиты вроде USBDeview/USBDetector. Prefetch сам по себе не доказывает очистку в ту же секунду."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="«Где искали» — это не название устройства, а место проверки: журналы Windows, файл setupapi.dev.log, программы очистки или противоречия между источниками."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Риск: Высокий — проверить в первую очередь; Средний — подозрительный контекст; Низкий — слабый сигнал; Информация — справочная запись без самостоятельного подозрительного признака."
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Наведите указатель на любую ячейку — над ней появится простое объяснение значения."
                                       Foreground="{StaticResource Accent2}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Установка Windows: " Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="CleanupOsInstallDateText" Text="не определена" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="CleanupGraceText"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Фильтр:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CleanupFilterCombo" Width="260" SelectionChanged="CleanupFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="Все записи" IsSelected="True"/>
                                    <ComboBoxItem Content="Только USB-утилиты"/>
                                    <ComboBoxItem Content="Только запуск утилит"/>
                                    <ComboBoxItem Content="Вероятная очистка"/>
                                    <ComboBoxItem Content="Только подозрительные"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Заметка эксперта к выделенной находке (попадает в отчёты и сохраняется между сканированиями):"
                                       Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="SaveExpertNoteButton" Content="Сохранить заметку" Click="SaveExpertNoteButton_Click" Margin="10,0,0,0" VerticalAlignment="Top"/>
                                <TextBox x:Name="ExpertNoteTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelDeep}" Foreground="{StaticResource TextSoft}" CaretBrush="{StaticResource TextSoft}" BorderBrush="{StaticResource Stroke}" Padding="6,4"/>
                            </DockPanel>
                            <TextBlock x:Name="ExpertNoteStatusText" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="FindingsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="FindingsGrid_SelectionChanged"
                              CellStyle="{StaticResource ExplainedDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата и время" Binding="{Binding TimestampText}" Width="150"/>
                            <DataGridTextColumn Header="Тип действия" Binding="{Binding ActionKindText}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding AssessmentText}" Width="170"/>
                            <DataGridTextColumn Header="Инициатор" Binding="{Binding InitiatorText}" Width="200"/>
                            <DataGridTextColumn Header="Инструмент" Binding="{Binding PossibleToolText}" Width="170"/>
                            <DataGridTextColumn Header="Уверенность" Binding="{Binding ConfidenceText}" Width="130"/>
                            <DataGridTextColumn Header="Риск" Binding="{Binding SeverityText}" Width="90"/>
                            <DataGridTextColumn Header="Где искали" Binding="{Binding AreaText}" Width="170"/>
                            <DataGridTextColumn Header="Что найдено" Binding="{Binding Finding}" Width="250"/>
                            <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="420"/>
                            <DataGridTextColumn Header="Заметка эксперта" Binding="{Binding ExpertNote}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Риски">
                <Grid Margin="4,14,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ExfiltrationRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="PolicyRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="MitreRow" Height="0"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Вкладка заполняется автоматически после сканирования: ниже появятся только те блоки, по которым что-то найдено. Ничего настраивать не нужно."
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RiskExfiltrationVerdictText" Foreground="#F5D98A" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6" Text="Выполните сканирование — оценка появится здесь автоматически."/>
                            <TextBlock x:Name="RiskPolicyVerdictText" Foreground="#C9E4FF" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6" Text=""/>
                            <TextBlock x:Name="RiskMitreVerdictText" Foreground="#A78BFA" FontSize="14" TextWrapping="Wrap" Text=""/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" x:Name="ExfiltrationSectionHeader" Visibility="Collapsed" Text="Вынос данных на съёмные носители" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,6"/>
                    <DataGrid Grid.Row="2" x:Name="ExfiltrationGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                        <Setter Property="Foreground" Value="#F5D98A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="360"/>
                            <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceDisplayName}" Width="240"/>
                            <DataGridTextColumn Header="Когда" Binding="{Binding WhenText}" Width="170"/>
                            <DataGridTextColumn Header="Уверенность" Binding="{Binding ConfidenceText}" Width="220"/>
                            <DataGridTextColumn Header="На чём основано" Binding="{Binding Basis}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="PolicySectionHeader" Visibility="Collapsed" Text="Соответствие политике устройств" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,6"/>
                    <DataGrid Grid.Row="4" x:Name="PolicyGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViolation}" Value="True">
                                        <Setter Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceDisplayName}" Width="320"/>
                            <DataGridTextColumn Header="VID / PID" Binding="{Binding VidPidText}" Width="160"/>
                            <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialText}" Width="200"/>
                            <DataGridTextColumn Header="Решение политики" Binding="{Binding DecisionText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="5" x:Name="MitreSectionHeader" Visibility="Collapsed" Text="Сопоставление с MITRE ATT&#38;CK" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,6"/>
                    <DataGrid Grid.Row="6" x:Name="MitreGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Техника" Binding="{Binding Technique.Id}" Width="110"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Technique.Name}" Width="300"/>
                            <DataGridTextColumn Header="Тактика" Binding="{Binding Technique.Tactic}" Width="200"/>
                            <DataGridTextColumn Header="Доказательств" Binding="{Binding EvidenceCount}" Width="120"/>
                            <DataGridTextColumn Header="Обоснование" Binding="{Binding Rationale}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Сторонние утилиты">
                <Grid Margin="4,14,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FindExternalUtilitiesButton" Content="Найти утилиты" Click="FindExternalUtilitiesButton_Click"/>
                                <Button x:Name="CaptureExternalUtilityButton" Content="Считать из окна" Click="CaptureExternalUtilityButton_Click" IsEnabled="False" Margin="8,0,0,0"/>
                                <Button x:Name="OpenExternalUtilityAnalysisTabButton" Content="Разбор строки →" Click="OpenExternalUtilityAnalysisTabButton_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ExternalUtilityStatusText" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" x:Name="ExternalUtilityInnerTabs" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Утилиты">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="280"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="Запущенные сейчас" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ListBox x:Name="RunningExternalUtilitiesList" DisplayMemberPath="ListDisplay" SelectionChanged="RunningExternalUtilitiesList_SelectionChanged" Background="{StaticResource PanelDeep}" BorderThickness="0" Foreground="{StaticResource TextSoft}"/>
                                    </DockPanel>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="6" Background="{StaticResource Stroke}" ShowsPreview="True"/>
                                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="Ранее запускались (по сканированию)" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ListBox x:Name="HistoricalUtilityLaunchesList" DisplayMemberPath="ListDisplay" Background="{StaticResource PanelDeep}" BorderThickness="0" Foreground="{StaticResource TextSoft}"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Данные">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Раздел:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ExternalUtilitySectionFilterCombo" Width="340" SelectionChanged="ExternalUtilitySectionFilterCombo_SelectionChanged"/>
                                    <Button x:Name="CopyExternalUtilityRowButton" Content="Копировать" Click="CopyExternalUtilityRowButton_Click" Margin="12,0,0,0" Padding="10,4"/>
                                    <Button x:Name="FillManualFromRowButton" Content="В поле ввода" Click="FillManualFromRowButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#101E30" BorderBrush="#264A70" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="ExternalUtilitySectionInfoTitle" Text="Выберите раздел или считайте данные из утилиты" Foreground="{StaticResource Accent2}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ExternalUtilitySectionInfoSummary" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ExternalUtilitySectionInfoReliability" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid Grid.Row="2" x:Name="ExternalUtilityRowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" SelectionChanged="ExternalUtilityRowsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Запись" Binding="{Binding PrimaryText}" Width="220" MinWidth="140"/>
                                        <DataGridTextColumn Header="VID / PID" Binding="{Binding VidPidText}" Width="100" MinWidth="80"/>
                                        <DataGridTextColumn Header="Производитель / модель" Binding="{Binding VendorProductText}" Width="200" MinWidth="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Вердикт" Binding="{Binding VerdictDisplayText}" Width="240" MinWidth="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ключевые поля" Binding="{Binding KeyFieldsText}" Width="*" MinWidth="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Разбор" x:Name="ExternalUtilityAnalysisTab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                                <StackPanel>
                                    <Border Background="#101E30" BorderBrush="#264A70" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="ExternalUtilityVerdictTitleText" Text="Выберите строку на вкладке «Данные»" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="По строке:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                                            <TextBlock x:Name="ExternalUtilityReportConclusionText" Foreground="#F5D98A" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="Procmon (жёсткое доказательство):" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                                            <TextBlock x:Name="ExternalUtilityReportConclusionProcmonText" Foreground="#7EE787" FontSize="13" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="ProcmonTraceButton" Content="Жёсткая трассировка (Procmon)" Click="ProcmonTraceButton_Click" Padding="10,4"/>
                                                <Button x:Name="OpenProcmonSessionFolderButton" Content="Папка сессии Procmon" Click="OpenProcmonSessionFolderButton_Click" Padding="10,4" Margin="8,0,0,0" IsEnabled="False"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ProcmonTraceStatusText" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="По делу:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                                            <TextBlock x:Name="ExternalUtilityReportConclusionCaseText" Foreground="#C9E4FF" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Text="Источники Windows:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                                            <TextBlock x:Name="ExternalUtilitySourceChecksText" Foreground="#9FD4B8" FontSize="12" FontFamily="Consolas, Segoe UI" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ExternalUtilityVidPidText" Foreground="#B8D4F0" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="ExternalUtilityOriginText" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="ExternalUtilityAuditMatchText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="Кратко:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                                            <TextBlock x:Name="ExternalUtilityBriefAnalysisText" Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap"/>
                                            <Button x:Name="CopyExternalUtilityAnalysisButton" Content="Копировать разбор" Click="CopyExternalUtilityAnalysisButton_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Строка из утилиты" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="ExternalUtilitySelectedRowSummaryText" Text="—" Foreground="{StaticResource TextSoft}" FontFamily="Consolas, Segoe UI" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Ручной ввод">
                            <Border Margin="0,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Вставьте одну строку из USBDetector/USBDeview или скопируйте её с вкладки «Данные»." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                    <TextBox x:Name="ExternalUtilityManualInput" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap" Background="{StaticResource PanelDeep}" Foreground="{StaticResource TextSoft}" BorderBrush="{StaticResource Stroke}" Margin="0,10,0,0"/>
                                    <Button x:Name="AnalyzeManualUtilityButton" Content="Разобрать вставку" Click="AnalyzeManualUtilityButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Отчет">
                <Border Margin="4,14,4,4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Полные отчёты содержат все данные для расследования. Сводные отчёты показывают ключевые цифры, инциденты и значимые устройства. Аналитическая записка — связный рассказ с общей хронологией событий. Доступны PDF и Excel. Таймлайн (CSV) открывается в Timeline Explorer и Excel. Пакет доказательств — ZIP с отчётами, сырьём и манифестом SHA-256 для передачи."
                                   Foreground="{StaticResource TextMain}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button x:Name="ManagerPdfReportButton" Content="Для руководителя (1 стр.)" Click="ManagerPdfReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="PdfReportButton" Content="Полный PDF" Click="PdfReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="AnalystNotePdfReportButton" Content="Аналитическая записка (PDF)" Click="AnalystNotePdfReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="BriefPdfReportButton" Content="Сводный PDF" Click="BriefPdfReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="ExcelReportButton" Content="Полный Excel" Click="ExcelReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="BriefExcelReportButton" Content="Сводный Excel" Click="BriefExcelReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="AnalystNoteExcelReportButton" Content="Аналитическая записка (Excel)" Click="AnalystNoteExcelReportButton_Click" IsEnabled="False"/>
                            <Button x:Name="TimelineCsvButton" Content="Таймлайн (CSV)" Click="TimelineCsvButton_Click" IsEnabled="False"/>
                            <Button x:Name="EvidencePackageButton" Content="Пакет доказательств (ZIP)" Click="EvidencePackageButton_Click" IsEnabled="False"/>
                            <Button Content="Открыть папку данных" Click="OpenDataFolderButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="ReportStatusText" Foreground="{StaticResource TextMuted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="{StaticResource PanelDeep}" Foreground="{StaticResource TextMuted}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
