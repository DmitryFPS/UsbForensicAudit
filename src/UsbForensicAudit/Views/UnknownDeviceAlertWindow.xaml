<Window x:Class="UsbForensicAudit.UnknownDeviceAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внимание: неизвестное устройство"
        Height="380"
        Width="900"
        MinHeight="280"
        MinWidth="640"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#1A0B0B">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#200D0D"/>
            <Setter Property="Foreground" Value="#F5D9D9"/>
            <Setter Property="BorderBrush" Value="#59201F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#491A1A"/>
            <Setter Property="VerticalGridLinesBrush" Value="#491A1A"/>
            <Setter Property="RowBackground" Value="#280F0F"/>
            <Setter Property="AlternatingRowBackground" Value="#301212"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#401212"/>
            <Setter Property="Foreground" Value="#FFC7C7"/>
            <Setter Property="BorderBrush" Value="#59201F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#F5D9D9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#280F0F" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="42" Height="42" Fill="#3A1111" Stroke="#EF4444" StrokeThickness="1.5"/>
                <Path Grid.Column="0" Stroke="#EF4444" StrokeThickness="2.4"
                      Data="M21,12 L21,24 M21,28 L21,30.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Подключено устройство, которого нет в доказательной базе"
                               Foreground="#FFE5E5" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Устройство не встречалось ни в одном из прошлых сканирований этой машины. Проверьте, ожидалось ли его подключение."
                               Foreground="#C79A9A"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="UnknownDevicesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding UnknownDevices}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Когда заметили" Binding="{Binding ConnectedAtText}" Width="175"/>
                <DataGridTextColumn Header="Что подключено" Binding="{Binding DeviceName}" Width="250"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerText}" Width="130"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding ModelText}" Width="140"/>
                <DataGridTextColumn Header="VID / PID" Binding="{Binding VidPidText}" Width="110"/>
                <DataGridTextColumn Header="Системный ID" Binding="{Binding DeviceId}" Width="330"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton"
                    Content="Понятно"
                    Padding="22,8"
                    FontWeight="SemiBold"
                    Foreground="#FFE5E5"
                    Background="#7F1D1D"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
