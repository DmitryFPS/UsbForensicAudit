<Window x:Class="UsbForensicAudit.NetworkConnectionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История сетевой связи"
        Width="1220"
        Height="780"
        MinWidth="820"
        MinHeight="540"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="#07111F">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E5F2FF"/>
            <Setter Property="Background" Value="#14532D"/>
            <Setter Property="BorderBrush" Value="#38D996"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#081320"/>
            <Setter Property="Foreground" Value="#D8E9FA"/>
            <Setter Property="BorderBrush" Value="#1F3B59"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#12293F"/>
            <Setter Property="RowBackground" Value="#0B1728"/>
            <Setter Property="AlternatingRowBackground" Value="#0E1D30"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#12293F"/>
            <Setter Property="Foreground" Value="#9FC6E4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#1F3B59"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8E9FA"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#175A78"/>
                    <Setter Property="Foreground" Value="#E5F2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14" Padding="16" Background="#0B1728" BorderBrush="#1F3B59" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="#38BDF8"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText"
                           Foreground="#D8E9FA"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <TextBlock Foreground="#8EA7BF" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="«Сеансы» — когда соединение открывали и закрывали по записям журналов Windows. Отдельным событием помечено то, у чего конца нет и быть не может: неудачная попытка, обрыв, обращение к серверу. «Куда ходили» — папки, адреса и скачанные файлы, найденные в следах пользователя и в истории браузера; у каждой строки написано, что означает её время и откуда она взята."/>
                <TextBlock x:Name="WarningText"
                           Foreground="#FBBF24"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
                <TabItem Header="Куда ходили">
                    <DataGrid x:Name="VisitsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Когда" Binding="{Binding WhenText}" Width="160"/>
                            <DataGridTextColumn Header="Что делали" Binding="{Binding KindText}" Width="230"/>
                            <DataGridTextColumn Header="Папка, адрес или узел" Binding="{Binding TargetText}" Width="420"/>
                            <DataGridTextColumn Header="Подпись" Binding="{Binding TitleText}" Width="320"/>
                            <DataGridTextColumn Header="Кто" Binding="{Binding UserText}" Width="180"/>
                            <DataGridTextColumn Header="Сколько раз" Binding="{Binding CountText}" Width="230"/>
                            <DataGridTextColumn Header="Что означает время" Binding="{Binding TimeMeaning}" Width="330"/>
                            <DataGridTextColumn Header="Откуда взято" Binding="{Binding SourceText}" Width="260"/>
                            <DataGridTextColumn Header="Ссылка на источник" Binding="{Binding Provenance}" Width="380"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Сеансы связи">
                    <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Отдельное событие и полный сеанс нельзя показывать одинаково:
                                         у первого нет длительности, и путать их значит выдумывать её. -->
                                    <DataTrigger Binding="{Binding IsMoment}" Value="True">
                                        <Setter Property="Foreground" Value="#9FB4C8"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#175A78"/>
                                        <Setter Property="Foreground" Value="#E5F2FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Подключение" Binding="{Binding StartedText}" Width="170"/>
                            <DataGridTextColumn Header="Отключение" Binding="{Binding EndedText}" Width="230"/>
                            <DataGridTextColumn Header="Сколько держалось" Binding="{Binding DurationText}" Width="150"/>
                            <DataGridTextColumn Header="Чем закончилось" Binding="{Binding OutcomeText}" Width="330"/>
                            <DataGridTextColumn Header="Подробности" Binding="{Binding ReasonText}" Width="420"/>
                            <DataGridTextColumn Header="Учётная запись" Binding="{Binding Account}" Width="180"/>
                            <DataGridTextColumn Header="Откуда взято" Binding="{Binding SourceText}" Width="260"/>
                            <DataGridTextColumn Header="Ссылка на источник" Binding="{Binding Provenance}" Width="380"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="О самой связи">
                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="FactsText" Foreground="#D8E9FA" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Скопировать историю в буфер"
                        Background="#123B57"
                        BorderBrush="#38BDF8"
                        Margin="0,0,10,0"
                        Click="CopyButton_Click"/>
                <Button Content="Закрыть" IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
