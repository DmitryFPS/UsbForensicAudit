<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Infrastructure собран с UseWPF: потребителю нужны те же reference-сборки WindowsDesktop. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>UsbForensicAudit.Cli</AssemblyName>
    <RootNamespace>UsbForensicAudit</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>UsbForensicAudit</Authors>
    <Product>UsbForensicAudit</Product>
    <Description>Headless CLI for Windows USB forensic audit</Description>
  </PropertyGroup>

  <!-- publish -r win-x64: не bin\Release\win-x64 (Rider/MSBuild часто держат DLL), только obj\rid-out -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <OutputPath>obj\rid-out\</OutputPath>
    <IntermediateOutputPath>obj\rid-int\</IntermediateOutputPath>
  </PropertyGroup>

  <!--
    Набор пакетов намеренно зеркалирует src/UsbForensicAudit/UsbForensicAudit.csproj:
    это позволяет держать packages.lock.json синхронным с GUI-проектом и не
    расходиться в разрешении транзитивных зависимостей между двумя exe.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsbForensicAudit.Application\UsbForensicAudit.Application.csproj" />
    <ProjectReference Include="..\UsbForensicAudit.Domain\UsbForensicAudit.Domain.csproj" />
    <ProjectReference Include="..\UsbForensicAudit.Infrastructure\UsbForensicAudit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsbForensicAudit.Tests" />
  </ItemGroup>

</Project>
